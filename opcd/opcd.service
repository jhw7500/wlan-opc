[Unit]
Description=OPC wireless-board control daemon (wlan-opc)
Documentation=https://github.com/jhw7500/wlan-opc
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/opc/bin/opcd
WatchdogSec=30s
WatchdogSignal=SIGKILL
TimeoutStartSec=30s
TimeoutStopSec=10s
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
